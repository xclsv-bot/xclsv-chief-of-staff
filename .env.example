# Names only — never values. Copy to .env and fill in locally.

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Identity (owner addresses — outbound-last detection keys off these)
ZAIRE_EMAIL=
ARYA_EMAIL=

# Triage sweep
TRIAGE_MAX_THREADS=
STATE_DB_PATH=

# Nudge threshold in business days (policy/tone live in agent/nudge-rules.md)
NUDGE_THRESHOLD_DAYS=

# Voice corpus (spec §6.1) — exclusion rules live in agent/corpus-exclusions.md
# Comma-separated Slack channel IDs Zaire designates for the internal register
SLACK_CORPUS_CHANNEL_IDS=
CORPUS_MAX_EMAILS=
ANTHROPIC_CLASSIFY_MODEL=
EMBEDDING_MODEL=

# Gmail (OAuth, draft-only scopes: read / modify-labels / archive / create-draft — never send, never delete)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_ZAIRE_REFRESH_TOKEN=
GMAIL_ARYA_REFRESH_TOKEN=

# Slack (#inbox-gps bot + designated-channel history read for the voice corpus)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_INBOX_GPS_CHANNEL_ID=
# Zaire's Slack member ID — ONLY this user's messages are parsed as instructions
ZAIRE_SLACK_USER_ID=
# How far back the inbox poller scans digest threads (default 48)
INBOX_LOOKBACK_HOURS=

# Zoom (read-only cloud-recording transcripts, polled)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
# Call digests post here (defaults to SLACK_INBOX_GPS_CHANNEL_ID if unset)
CALL_DIGESTS_CHANNEL_ID=
CALL_LOOKBACK_DAYS=
CALL_CORRECTION_MINUTES=

# Asana (create tasks + comments only)
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_GID=
ASANA_ZAIRE_USER_GID=
ASANA_ARYA_USER_GID=

# Transcription (Whisper or equivalent)
OPENAI_API_KEY=

# Audio digest (optional — digest attaches a voice note when set)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Voice interface (v1.4 spec — docs/voice-interface-spec.md)
OPENAI_REALTIME_MODEL=
VOICE_ID=
# 32 random bytes hex; gates the PWA URL (?k=<secret>)
VOICE_SHARED_SECRET=
VOICE_APP_URL=
